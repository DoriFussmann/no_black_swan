---
import { HEADER_CTA, NAV } from "../config/site";
import Wordmark from "./Wordmark.astro";

const path = Astro.url.pathname;
function current(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="container-page header-bar">
    <Wordmark />
    <button
      type="button"
      id="nav-toggle"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">☰</span>
    </button>
    <nav id="site-nav" class="site-nav hidden md:flex">
      <ul class="flex flex-col md:flex-row md:items-center">
        {NAV.map((item) => (
          <li>
            <a class="nav-link" href={item.href} aria-current={current(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary" href={HEADER_CTA.href}>{HEADER_CTA.label}</a>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var toggle = document.getElementById("nav-toggle");
    var nav = document.getElementById("site-nav");
    if (!toggle || !nav) return;
    toggle.addEventListener("click", function () {
      var open = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (root.getAttribute("data-hero") !== "photo" || root.getAttribute("data-header") !== "blur") return;
    var header = document.querySelector(".site-header");
    if (!header) return;
    function sync() {
      header.classList.toggle("is-scrolled", window.scrollY > 16);
    }
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  })();
</script>
