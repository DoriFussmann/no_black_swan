---
interface Props {
  image: string;
  alt: string;
  src?: string;
  eager?: boolean;
}
const { image, alt, src, eager = false } = Astro.props;
void image;
const hasSrc = typeof src === "string" && src.length > 0;
---

<div class="media-frame">
  {hasSrc ? (
    <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
  ) : (
    <div class="placeholder-frame" role="img" aria-label={alt}></div>
  )}
</div>
