---
import { LEGAL_LINKS, NAV, SITE_NAME, SITE_TAGLINE } from "../config/site";
import Wordmark from "./Wordmark.astro";

const columns = [
  { heading: "Company", links: [...NAV.filter((item) => item.href !== "/articles/"), { label: "Team", href: "/team/" }] },
  { heading: "Resources", links: [NAV.find((item) => item.href === "/articles/")!, { label: "FAQ", href: "/faq/" }] },
  { heading: "Legal", links: LEGAL_LINKS },
];
---

<footer class="site-footer">
  <div class="container-page">
    <div class="footer-grid">
      <div class="footer-brand">
        <Wordmark />
        <p>{SITE_TAGLINE}</p>
      </div>
      {columns.map((column) => (
        <nav class="footer-col" aria-label={column.heading}>
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((item) => (
              <li><a class="nav-link" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="legal-row">
      <p>© {new Date().getUTCFullYear()} {SITE_NAME}</p>
    </div>
  </div>
</footer>
