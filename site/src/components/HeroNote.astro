---
// Home hero, right column: a short note from the founder, as one card.
// The hero should read as a person and a hands-on service, not a product demo.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import doriPortrait from "../assets/founder/dori-fussmann/photo.jpg";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const logos = [
  { file: "morgan-stanley.png", name: "Morgan Stanley", height: 17 },
  { file: "the-vets.png", name: "The Vets", height: 30 },
  { file: "cornell-tech.png", name: "Cornell Tech", height: 30 },
  { file: "yale.png", name: "Yale", height: 26 },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { ...item, src: mod.default };
});
---

<div class="hero-note">
  <article
    class="hero-card"
    aria-label="A note from Dori Fussmann, founder of No Black Swan"
  >
    <div class="hero-card__who">
      <Image
        class="hero-card__photo"
        src={doriPortrait}
        alt="Photograph of Dori Fussmann, founder of No Black Swan"
        width={128}
        height={128}
      />
      <div>
        <p class="hero-card__name">Dori Fussmann</p>
        <p class="hero-card__role">Founder, No Black Swan</p>
      </div>
    </div>
    <p class="hero-card__body hero-card__body--lead">
      I've been the CEO, the COO and the CFO in the room. Now I put AI to
      work inside businesses.<br />
      I learn how your business runs, find where AI makes a real difference,
      and build it into the work with your team.<br />
      Every step is scoped, agreed and transparent.
    </p>
    <p class="hero-card__body hero-card__cta">Let's talk.</p>
    <ul class="hero-card__foot hero-card__logos" aria-label="Where Dori has worked and mentors">
      {
        logos.map((logo) => (
          <li>
            <Image
              src={logo.src}
              alt={logo.name}
              height={logo.height * 2}
              width={Math.round((logo.src.width / logo.src.height) * logo.height * 2)}
              style={`height:${logo.height}px`}
            />
          </li>
        ))
      }
    </ul>
  </article>
</div>

<style>
  .hero-note {
    --ink: #1a1a2e;
    --body: #2d2d2d;
    --muted: #5c5c5c;
    --line: #e4e2de;
    --accent-text: #7a5c28;
    --accent: #b5935a;
    max-width: 520px;
    margin-left: auto;
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px 32px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(26, 26, 46, 0.04),
      0 12px 32px -18px rgba(26, 26, 46, 0.18);
  }

  .hero-card p {
    margin: 0;
  }

  .hero-card__foot {
    margin-top: auto !important;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .hero-card__who {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hero-card__photo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero-card__name {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .hero-card__role {
    margin-top: 2px !important;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .hero-card__body {
    margin: 18px 0 20px !important;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--body);
  }

  /* One blank line between the note and "Let's talk." */
  .hero-card__body--lead {
    margin-bottom: 0 !important;
  }

  .hero-card__cta {
    margin-top: 1.65em !important;
  }

  .hero-card__logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    list-style: none;
  }

  .hero-card__logos li {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .hero-card__logos img {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .hero-note {
      max-width: none;
      margin-left: 0;
    }

    .hero-card {
      padding: 22px 20px 20px;
    }
  }

  @media (max-width: 419px) {
    .hero-card__logos {
      gap: 14px;
    }

    .hero-card__logos img {
      transform: scale(0.85);
      transform-origin: left center;
    }
  }
</style>
