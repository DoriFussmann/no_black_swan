---
interface Props {
  faqs: {
    question: string;
    answer: string;
    /** Optional labelled list shown under the answer text. */
    items?: { label: string; text: string }[];
  }[];
  bordered?: boolean;
}

const { faqs, bordered = true } = Astro.props;
---

<section class:list={[{ "rule mt-2xl pt-xl": bordered }]}>
  <h2 id="faq-heading" class="type-h2">Frequently Asked Questions</h2>
  <div class="faq-list mt-lg">
    {
      faqs.map((faq) => (
        <details class="faq-item">
          <summary class="type-h4">{faq.question}</summary>
          <div class="faq-item__panel">
            <div class="faq-item__body">
              {faq.items && faq.items.length > 0 ? (
                <>
                  <p class="type-body faq-item__lead">{faq.answer}</p>
                  <ul class="faq-item__list type-body">
                    {faq.items.map((item) => (
                      <li>
                        <strong>{item.label}</strong> {item.text}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p class="type-body">{faq.answer}</p>
              )}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
