---
interface Section {
  heading: string;
  items: { label: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section class:list={["section", alt && "section-alt"]} aria-labelledby="trust-heading">
  <div class="container-page stack-lg">
    <div class="section-head">
      <h2 id="trust-heading" class="h2 reveal">{section.heading}</h2>
    </div>
    <ul class="card-grid indexed" data-count={section.items.length}>
      {section.items.map((item) => (
        <li class="card reveal">
          <p class="m-0">{item.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
