---
interface Section {
  eyebrow?: string;
  heading: string;
  intro?: string;
  steps: { title: string; text: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section id={section.id} class:list={["section", "section-process", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    <div class="section-head">
      {section.eyebrow && <p class="eyebrow reveal">{section.eyebrow}</p>}
      <h2 class="h2 reveal">{section.heading}</h2>
      {section.intro && <p class="lead reveal">{section.intro}</p>}
    </div>
    <ol class="card-grid indexed" data-count={section.steps.length}>
      {section.steps.map((step) => (
        <li class="card reveal">
          <h3 class="h3 card-title">{step.title}</h3>
          <p class="muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
