---
interface Section {
  heading?: string;
  items: { value: string; label: string }[];
}
interface Props {
  section: Section;
  alt?: boolean;
}
const { section, alt = false } = Astro.props;
---
<section class:list={["section", alt && "section-alt"]}>
  <div class="container-page stack-lg">
    {section.heading && <h2 class="h2 reveal">{section.heading}</h2>}
    <ul class="card-grid" data-count={section.items.length}>
      {section.items.map((item) => (
        <li class="stat-tile reveal">
          <p class="muted m-0">{item.label}</p>
          <p class="stat-value">{item.value}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
