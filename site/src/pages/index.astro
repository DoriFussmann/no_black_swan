---
import HeroFlow from "../components/HeroFlow.astro";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import CaseStack from "../components/CaseStack.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import type { ImageMetadata } from "astro";
import { orgId } from "seo-core";
import { DORI_LINKEDIN, SITE_URL } from "../config/site";
import { absoluteUrl, sitePath } from "../lib/url";
import doriPortrait from "../assets/founder/dori-fussmann/photo.jpg";
import linkedinLogo from "../assets/brand/linkedin.png";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const clientLogos = [
  { file: "ambi-robotics.png", name: "Ambi Robotics" },
  { file: "bluemark.png", name: "BlueMark" },
  { file: "guardian-vets.png", name: "GuardianVets" },
  { file: "jbecca.png", name: "jBecca" },
  { file: "lena-health.png", name: "LenaHealth" },
  { file: "manatee.png", name: "Manatee" },
  { file: "natrion.png", name: "Natrion" },
  { file: "pluto-vets.png", name: "PlutoVets" },
  { file: "powder-pics.png", name: "PowderPics" },
  { file: "sorso.png", name: "Sorso" },
  { file: "sunday.png", name: "Sunday" },
  { file: "swift-vets.png", name: "SwiftVets" },
  { file: "the-vets.png", name: "The Vets" },
  { file: "translucent-ai.png", name: "Translucent AI" },
  { file: "user1st.png", name: "User1st" },
  { file: "vetnio.png", name: "Vetnio" },
  { file: "yourpath.png", name: "YourPath" },
  { file: "sniffi.png", name: "Sniffi" },
  { file: "snout.png", name: "Snout" },
  { file: "reside-health.png", name: "ResideHealth" },
  { file: "dex-world.png", name: "Dex World" },
  { file: "tailplans.png", name: "Tailplans" },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { name: item.name, src: mod.default };
});

const title = "AI Integration for Growing Businesses | No Black Swan";
const description =
  "No Black Swan helps businesses put AI to work, integrating it into their operations, workflows and everyday decisions. Book a free consultation with Dori.";

const pillars = [
  {
    title: "Understand & Identify",
    summary:
      "We get inside the business, understand how it operates, map its workflows, systems and constraints, and identify where AI can make a meaningful difference.",
    items: [
      {
        title: "Understand the operation",
        body: "Get to know the company’s goals, teams, systems, workflows and constraints.",
      },
      {
        title: "Map the terrain",
        body: "Understand workflows, handoffs, information flows, bottlenecks and decision points.",
      },
      {
        title: "Identify the opportunities",
        body: "Find where AI can improve performance, reduce friction or create new capabilities.",
      },
    ],
  },
  {
    title: "Strategy & Operational Plan",
    summary:
      "Turn the findings into an executable plan. Decide what to tackle, in what order, with which tools, resources and dependencies.",
    items: [
      {
        title: "Set the priorities",
        body: "Rank opportunities by business impact, feasibility, risk and effort.",
      },
      {
        title: "Design the solution",
        body: "Define the workflows, systems, integrations and human oversight required.",
      },
      {
        title: "Build the execution plan",
        body: "Establish scope, owners, milestones, dependencies and success criteria.",
      },
    ],
  },
  {
    title: "Execute & Operate",
    summary:
      "We work alongside the business to build, integrate, deploy and operate the solutions. Execution includes adoption, feedback loops and continuous improvement.",
    items: [
      {
        title: "Deploy",
        body: "Build and integrate solutions into actual business systems and workflows.",
      },
      {
        title: "Operate",
        body: "Work with teams, manage implementation and make sure solutions function in day-to-day operations.",
      },
      {
        title: "Adapt and improve",
        body: "Monitor performance, gather feedback, address friction and refine the solutions as the business evolves.",
      },
    ],
  },
];

const faqs = [
  {
    question: "What does No Black Swan do?",
    answer:
      "No Black Swan helps businesses put AI to work by identifying opportunities and integrating practical AI solutions into their operations, workflows and everyday decisions.",
  },
  {
    question: "Do you only provide AI advice, or do you implement solutions too?",
    answer:
      "Both. We start by understanding the business and identifying where AI can help. Where there is a sensible opportunity, we design and implement the solution in the company’s actual workflows and operations.",
  },
  {
    question: "Do you guarantee cost savings, revenue growth or other results?",
    answer:
      "No. Every business is different, and outcomes depend on the company, the opportunity and the implementation. We commit to thoughtful advice, hard work and practical implementation—not guaranteed financial or operational results.",
  },
  {
    question: "What kinds of businesses do you work with?",
    answer:
      "We start with the business, not a fixed industry or one-size-fits-all package. The free consultation helps determine whether there are meaningful opportunities to integrate AI into your company.",
  },
  {
    question: "Do we need to know which AI tools we want to use?",
    answer:
      "No. You do not need to arrive with a tool list or a technical plan. We begin by understanding how your business works and determine what approaches make sense.",
  },
  {
    question: "What happens after the free consultation?",
    answer:
      "If there is a good opportunity to work together, we define the initial scope and priorities, agree on the fee, and begin with an assessment and setup phase followed by an ongoing monthly engagement.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Integration Services",
    provider: { "@id": orgId(SITE_URL) },
    serviceType: "Business consulting and AI integration",
    description,
    url: absoluteUrl("/"),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-lg pt-xl lg:pb-xl lg:pt-2xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="visually-hidden">AI Integration. By Operators, Not Consultants.</h1>
          <p class="hero-headline" aria-hidden="true">
            AI Integration.<br />
            By Operators, Not
            <span class="hero-typewriter" data-typewriter>
              <span class="hero-typewriter__sizer">Consultants.</span>
              <span class="hero-typewriter__live">
                <span data-typewriter-text>Consultants.</span><span
                  class="hero-typewriter__cursor"></span>
              </span>
            </span>
          </p>
          <p class="type-body mt-lg max-w-prose">
            We work alongside businesses to identify opportunities, implement
            practical AI solutions and integrate them into real business
            operations.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Book a Free Consultation</a>
            <a class="btn-quiet" href="#how-it-works">See the process</a>
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <HeroFlow />
        </div>
      </div>
    </section>

    <section class="site-wrap pt-md pb-lg lg:pt-lg lg:pb-xl reveal" aria-labelledby="clients-heading">
      <p class="type-label" id="clients-heading">Select Clients</p>
      <div class="mt-xl">
        <LogoMarquee logos={clientLogos} />
      </div>
    </section>

    <section class="site-wrap pt-lg pb-xl lg:pt-xl lg:pb-2xl reveal" aria-labelledby="about-heading">
      <div class="founder-grid founder-grid--about">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h2 id="about-heading" class="type-h2 mt-md">
            Built by an Entrepreneur. Grounded in Operations.
          </h2>
          <p class="type-body mt-lg max-w-prose">
            Dori Fussmann is an entrepreneur, founder and business leader who
            works at the intersection of business operations, operational
            leadership and AI implementation.
          </p>
          <p class="type-body mt-md max-w-prose">
            He has founded and built companies, including The Vets, and worked
            directly inside businesses as a Fractional COO and AI Operations
            Integrator. His work in these roles includes Natrion, JBecca,
            Manatee, The Vets and User1st — helping companies strengthen their
            operations, improve how teams and systems work together, and
            integrate AI into real business workflows.
          </p>
          <p class="type-body mt-md max-w-prose">
            His broader experience spans Fractional CFO roles, fundraising and
            strategic finance advisory, and investment banking at Citi, Morgan
            Stanley and Ion Pacific. He also mentors founders through Cornell
            Tech’s Runway Startups Program and Yale’s Tsai CITY.
          </p>
          <p class="type-body mt-md max-w-prose">
            That experience shapes how No Black Swan works. We don’t approach AI
            as a technology exercise. We start with the business: its operating
            model, people, processes, systems and constraints. Then we identify
            where AI can improve operational performance and implement solutions
            directly into the way the business works.
          </p>
          <p class="mt-xl">
            <a class="btn-quiet" href={sitePath("/about/")}>Read more about Dori’s background</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Dori Fussmann, founder of No Black Swan"
              width={192}
              height={192}
            />
            <div class="founder-panel__identity">
              <h3 class="type-h3 founder-panel__name">Dori Fussmann</h3>
              <p class="type-label mt-xs">Founder</p>
              <p class="founder-panel__links">
                <a
                  class="founder-panel__linkedin"
                  href={DORI_LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Dori Fussmann on LinkedIn"
                >
                  <Image
                    src={linkedinLogo}
                    alt=""
                    width={20}
                    height={20}
                  />
                </a>
              </p>
            </div>
            <button
              type="button"
              class="founder-panel__expand"
              data-case-expand
              aria-expanded="false"
              aria-label="Expand all roles"
            >
              <span class="founder-panel__expand-chevron" aria-hidden="true"></span>
            </button>
          </div>
          <CaseStack />
        </aside>
      </div>
    </section>

    <section
      id="how-it-works"
      class="site-wrap section-block pt-xl pb-xl lg:pt-2xl lg:pb-2xl rule reveal"
      aria-labelledby="process-heading"
    >
      <p class="type-label">The Process</p>
      <h2 id="process-heading" class="type-h2 mt-md">
        From understanding to execution.
      </h2>
      <ol class="step-stack mt-xl">
        {
          pillars.map((pillar, index) => (
            <li class="step-band">
              <p class="step-script">Step {index + 1}</p>
              <h3 class="type-h2">{pillar.title}</h3>
              <p class="type-body">{pillar.summary}</p>
              <div class="step-band__stages">
                {pillar.items.map((item) => (
                  <details class="pillar-item">
                    <summary class="type-h4">{item.title}</summary>
                    <div class="pillar-item__panel">
                      <div class="pillar-item__body">
                        <p class="type-body-sm">{item.body}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>See how No Black Swan works</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<script>
  // Same typewriter as the Rupert homepage: type, hold, delete, next phrase.
  const phrases = [
    { text: "Consultants.", color: "#C0392B" },
    { text: "Clowns.", color: "#B85C38" },
    { text: "\u201CMentors\u201D.", color: "#C07C2A" },
  ];

  const root = document.querySelector("[data-typewriter]");
  const textEl = root?.querySelector("[data-typewriter-text]");
  if (root instanceof HTMLElement && textEl instanceof HTMLElement) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const paint = (phrase: { text: string; color: string }, chars?: number) => {
      root.style.setProperty("--typewriter-color", phrase.color);
      textEl.textContent =
        chars === undefined ? phrase.text : phrase.text.slice(0, chars);
    };

    paint(phrases[0]);

    if (!reduceMotion) {
      const typeMs = 70;
      const deleteMs = 40;
      const holdMs = 2000;
      const gapMs = 260;

      let index = 0;
      let chars = phrases[0].text.length;
      let deleting = true;
      let timer: number | undefined;

      const queue = (fn: () => void, delay: number) => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = window.setTimeout(fn, delay);
      };

      const tick = () => {
        if (document.hidden) {
          queue(tick, holdMs);
          return;
        }

        const phrase = phrases[index];

        if (!deleting) {
          chars += 1;
          paint(phrase, chars);
          if (chars >= phrase.text.length) {
            deleting = true;
            queue(tick, holdMs);
            return;
          }
          queue(tick, typeMs);
          return;
        }

        chars -= 1;
        paint(phrase, chars);
        if (chars <= 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
          queue(tick, gapMs);
          return;
        }
        queue(tick, deleteMs);
      };

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) queue(tick, 80);
      });

      queue(tick, holdMs);
    }
  }
</script>
