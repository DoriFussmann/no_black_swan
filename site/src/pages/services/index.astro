---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { sitePath } from "../../lib/url";

const title = "AI Integration Services for Businesses | No Black Swan";
const description =
  "Discover how No Black Swan identifies AI opportunities and implements practical solutions across business operations, workflows, systems and teams.";

// Capabilities, not prepackaged products or claims of completed client projects.
const capabilities = [
  {
    title: "Workflow automation & integration",
    body: "Connect systems, automate repetitive tasks and improve the flow of work between people, tools and processes.",
  },
  {
    title: "Internal knowledge & information",
    body: "Make company information easier to organize, retrieve and use. Build AI-enabled workflows that help teams access relevant business knowledge.",
  },
  {
    title: "AI assistants & internal tools",
    body: "Design and build practical assistants and purpose-built tools that support specific business tasks using relevant company context.",
  },
  {
    title: "Document & data workflows",
    body: "Improve how information and documents are processed, extracted, organized and routed through the business.",
  },
];

// Examples of where the capabilities apply: not separate service packages.
const areas = [
  { title: "Operations", body: "Repetitive processes, handoffs and administrative work." },
  { title: "Finance", body: "Reporting, analysis and recurring finance workflows." },
  { title: "Sales & Marketing", body: "Research, preparation, follow-up and internal workflows." },
  { title: "Customer Operations", body: "Knowledge access, support workflows and service processes." },
  { title: "Management & Teams", body: "Internal information, coordination and decision support." },
];

const faqs = [
  {
    question: "What kinds of AI solutions do you implement?",
    answer:
      "Our work can include workflow automation, internal knowledge systems, AI assistants, document processes and integrations with existing business systems. We determine the right approach based on the actual business need.",
  },
  {
    question: "Do you work with a specific industry?",
    answer:
      "We work across industries. We start by understanding how each business operates rather than applying a fixed industry template.",
  },
  {
    question: "Do you only advise, or do you actually implement?",
    answer:
      "We implement. We identify opportunities, design solutions, build and integrate them into business workflows, and work alongside teams to make them function in practice.",
  },
  {
    question: "Do we need an internal technical team?",
    answer:
      "Not necessarily. We assess your existing systems, team and requirements to determine what is needed to deliver the work.",
  },
  {
    question: "Will you replace our existing software?",
    answer:
      "Not by default. We first examine the systems you already use and look for practical ways to improve or connect them.",
  },
  {
    question: "How do we get started?",
    answer:
      "Start with a free 30-minute consultation with Dori. You’ll receive a concise, high-level summary of the opportunities discussed and a proposed plan within a few hours, at no charge.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/services/" jsonLd={jsonLd}>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">What We Do</p>
      <h1 class="type-h1 mt-md">Practical AI implementation across your business.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        We identify where AI can make a meaningful difference to the way your
        business operates, then design, build and integrate solutions into the
        workflows and systems your team uses.
      </p>
      <p class="type-body mt-md max-w-prose">
        That might mean improving one recurring process, connecting disconnected
        systems, making company knowledge easier to use, or building AI-powered
        tools around a specific business need.
      </p>
      <p class="type-body mt-md max-w-prose">
        We start with the business problem. The technology follows.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="capabilities-heading">
      <p class="type-label">Our Capabilities</p>
      <h2 id="capabilities-heading" class="type-h2 mt-md">What we implement.</h2>
      <ul class="capability-grid mt-2xl">
        {
          capabilities.map((item) => (
            <li class="experience-card experience-card--compact">
              <h3 class="experience-card__value">{item.title}</h3>
              <p class="type-body">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="type-body mt-xl max-w-prose">
        These are capabilities, not prepackaged products. The actual solution
        depends on the business and the problem we’re solving.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="areas-heading">
      <p class="type-label">Across the Business</p>
      <h2 id="areas-heading" class="type-h2 mt-md">Where we apply them.</h2>
      <div class="plan-card mt-2xl">
        <p class="plan-card__label">Examples by area of the business</p>
        <ul class="plan-checks areas-list">
          {
            areas.map((row) => (
              <li>
                <h3 class="plan-item__title">{row.title}</h3>
                <p class="plan-item__body">{row.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="type-body mt-xl max-w-prose">
        These are examples of where the capabilities can be applied, not five
        separate service packages.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="operation-heading">
      <p class="type-label">From Opportunity to Operation</p>
      <h2 id="operation-heading" class="type-h2 mt-md">We don’t hand over recommendations and walk away.</h2>
      <p class="type-body mt-md max-w-prose">
        We work alongside your business to turn identified opportunities into
        working solutions. That means designing the approach, building and
        integrating the technology, supporting its adoption and continuing to
        improve it once it’s in use.
      </p>
      <p class="mt-xl flex flex-wrap items-center gap-md">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a Free Consultation</a>
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>See how the process works</a>
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<style>
  /* Four capabilities: one column on small screens, two across from tablet up. */
  .capability-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    list-style: none;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Five example areas: two columns on wide screens so the list stays short. */
  @media (min-width: 900px) {
    .areas-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }

    .areas-list > li:nth-child(2) {
      border-top: 0;
      padding-top: 0;
    }

    .areas-list > li:nth-child(2)::before {
      top: 5px;
    }
  }
</style>
