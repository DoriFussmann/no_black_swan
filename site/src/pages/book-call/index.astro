---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DORI_LINKEDIN } from "../../config/site";
import { CAL_COM_URL } from "../../config/publicEnv";
import { sitePath } from "../../lib/url";

const title = "Book a Free AI Integration Consultation | No Black Swan";
const description =
  "Book a free 30-minute consultation with Dori Fussmann to discuss your business and explore where AI could be integrated into your operations and workflows.";

const cover = [
  { title: "Your business", text: "What the company does, how it operates, its priorities and the challenges you are working through." },
  { title: "Where AI may help", text: "Processes, workflows and decisions where AI could save effort, improve access to information or support the team." },
  { title: "Practical opportunities", text: "Initial thoughts on what may be worth exploring, what could be implemented and what needs closer assessment." },
  { title: "Whether there’s a fit", text: "An honest conversation about whether No Black Swan can help and what a sensible next step might look like." },
];

// Why speak with Dori: the angles he brings, without naming companies.
const lenses = [
  { title: "Founder & operator", text: "Built and led companies, including The Vets. Understands the decisions, trade-offs and operational realities that come with running a business." },
  { title: "Business advisor", text: "Works directly with leadership teams on strategy, finance, priorities and execution, with a focus on practical recommendations." },
  { title: "Fractional CFO", text: "Works inside businesses on financial planning, reporting, decision support and the operating questions that affect performance." },
  { title: "AI practitioner", text: "Uses AI as a core part of how he works and advises, with a focus on integrating it into useful business processes rather than adopting tools for their own sake." },
];

---

<BaseLayout title={title} description={description} canonicalPath="/book-call/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap grid gap-2xl py-2xl lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-lg lg:gap-y-xl lg:py-3xl">
      <div class="order-1 lg:col-span-6 lg:col-start-1 lg:row-start-1">
        <h1 class="type-h1">Let’s talk about your business.</h1>
        <p class="type-body-lg mt-lg max-w-prose">
          A free 30-minute conversation with
          <a href={sitePath("/about/")}>Dori Fussmann</a>, founder of No Black
          Swan. Tell him how your business works and what you are trying to
          improve. He’ll share his perspective on where AI may be useful and
          what you could explore.
        </p>
        <p class="mt-md">
          <a href={DORI_LINKEDIN} target="_blank" rel="noopener noreferrer">
            Dori Fussmann on LinkedIn
          </a>
        </p>

        <h2 class="type-h2 mt-2xl">Who the call is for</h2>
        <p class="type-body mt-md max-w-prose">
          Business owners and leadership teams who want to understand where AI
          can make a practical difference in their company’s operations,
          workflows and everyday decisions.
        </p>
      </div>

      <div class="order-3 lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:self-start">
        <h2 class="type-h2">What we'll cover</h2>
        <ol class="call-cover mt-lg">
          {
            cover.map((item, i) => (
              <li class="call-cover__item">
                <span class="call-cover__num">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="call-cover__title">{item.title}</h3>
                <p class="call-cover__text">{item.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="type-body-sm mt-md text-muted">30 minutes · free · no obligation</p>

        <h2 class="type-h2 mt-2xl">Why speak with Dori?</h2>
        <p class="type-body mt-md max-w-prose">
          <a href={sitePath("/about/")}>Dori</a> has spent years working closely
          with businesses—as a founder, fractional CFO and advisor. He
          understands that good advice starts with understanding the company,
          its people, its systems and the realities of getting work done. He
          also uses AI extensively in his own work and in how he supports
          businesses.
        </p>
        <ul class="call-lenses mt-lg">
          {
            lenses.map((l) => (
              <li class="call-lenses__item">
                <span class="call-lenses__title">{l.title}</span>
                <span class="call-lenses__text">{l.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="type-body mt-lg max-w-prose">
          What that means for a 30-minute call: you get a direct conversation
          with someone who understands business operations and works
          extensively with AI. Explain how your company works, and Dori will
          share an experienced perspective on where AI may fit, what could be
          worth pursuing and where it may not make sense.
        </p>
        <p class="type-body rule mt-xl max-w-prose pt-lg">
          The goal is straightforward: understand your business, share useful
          advice and determine whether there is a sensible opportunity to
          <a href={sitePath("/how-it-works/")}>work together</a>. No pressure,
          no obligation and no promises of predetermined results.
        </p>
      </div>

      <div class="order-2 lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1">
        <div class="lead-form" id="booking-scheduler" data-calendar={CAL_COM_URL}>
          <h2 class="type-h2">Pick a day and time</h2>
          <p class="type-body mt-md">
            Choose a 30-minute slot below. The consultation is free, and booking takes under a minute.
          </p>

          <div class="cal-embed" id="cal-embed" aria-label="Booking calendar"></div>
          <p class="form-note">
            Calendar not showing?
            <a href={CAL_COM_URL} target="_blank" rel="noopener noreferrer">Book on Cal.com</a>.
          </p>

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  type CalCommand = ((...args: unknown[]) => void) & {
    loaded?: boolean;
    ns?: Record<string, CalCommand>;
    q?: unknown[];
  };

  declare global {
    interface Window {
      Cal?: CalCommand;
    }
  }

  // Cal.com's embed snippet: queues commands until embed.js loads.
  function ensureCal() {
    if (window.Cal) return;
    const stub = function Cal(...args: unknown[]) {
      const cal = window.Cal as CalCommand;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        document.head.appendChild(document.createElement("script")).src = "https://app.cal.com/embed/embed.js";
        cal.loaded = true;
      }
      (cal.q = cal.q || []).push(args);
    } as CalCommand;
    stub.q = [];
    stub.ns = {};
    window.Cal = stub;
  }

  const scheduler = document.getElementById("booking-scheduler");
  const embed = document.getElementById("cal-embed");
  const calendarUrl = scheduler instanceof HTMLElement ? scheduler.dataset.calendar || "" : "";

  if (embed instanceof HTMLElement && calendarUrl) {
    ensureCal();
    window.Cal?.("init", { origin: "https://cal.com" });
    window.Cal?.("inline", {
      elementOrSelector: embed,
      calLink: new URL(calendarUrl).pathname.replace(/^\/+|\/+$/g, ""),
      config: { layout: "month_view", theme: "light" },
    });

    // Conversion tracking (invisible): record a completed booking in GA4 as
    // `book_call`. Cal.com fires bookingSuccessfulV2 (newer) and/or
    // bookingSuccessful (older); send at most one event per page view.
    let bookingTracked = false;
    const trackBooking = () => {
      if (bookingTracked) return;
      bookingTracked = true;
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      gtag?.("event", "book_call", { method: "cal_com" });
    };
    window.Cal?.("on", { action: "bookingSuccessfulV2", callback: trackBooking });
    window.Cal?.("on", { action: "bookingSuccessful", callback: trackBooking });
  }
</script>

<style>
  .call-cover {
    display: grid;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin-left: 0;
  }
  @media (min-width: 640px) {
    .call-cover { grid-template-columns: 1fr 1fr; }
  }
  .call-cover__item {
    position: relative;
    background: #ffffff;
    border: 1px solid #e4e2de;
    border-radius: 12px;
    padding: 20px 20px 20px;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .call-cover__item::before {
    content: "";
    position: absolute;
    left: 20px;
    right: 20px;
    top: 0;
    height: 2px;
    background: #b5935a;
    opacity: 0.55;
    border-radius: 0 0 2px 2px;
  }
  .call-cover__item:hover { border-color: #b5935a; transform: translateY(-1px); }
  .call-cover__num {
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: 12px;
    color: #7a5c28;
    letter-spacing: 0.04em;
  }
  .call-cover__title {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 500;
    color: #1a1a2e;
  }
  .call-cover__text {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #2d2d2d;
  }
  .call-lenses {
    list-style: none;
    padding: 0;
    margin-left: 0;
    border-top: 1px solid #e4e2de;
  }
  .call-lenses__item {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid #e4e2de;
  }
  @media (min-width: 640px) {
    .call-lenses__item { grid-template-columns: 160px 1fr; gap: 16px; }
  }
  .call-lenses__title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: #7a5c28;
    padding-top: 3px;
  }
  .call-lenses__text {
    font-size: 15px;
    line-height: 1.65;
    color: #2d2d2d;
  }
  @media (prefers-reduced-motion: reduce) {
    .call-cover__item { transition: none; }
    .call-cover__item:hover { transform: none; }
  }
</style>
