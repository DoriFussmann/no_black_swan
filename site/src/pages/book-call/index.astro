---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DORI_LINKEDIN } from "../../config/site";
import { CAL_COM_URL } from "../../config/publicEnv";
import { sitePath } from "../../lib/url";

const title = "Book a Free AI Consultation With Dori Fussmann | No Black Swan";
const description =
  "Book a free 30-minute AI consultation with Dori Fussmann. Explore practical AI opportunities for your business and receive a high-level summary and proposed plan at no charge.";

const cover = [
  { title: "Your business", text: "What the company does, how it operates, its priorities and the challenges you’re facing." },
  { title: "Your workflows", text: "Where work gets stuck, processes are repetitive, systems don’t connect or information is difficult to access." },
  { title: "AI opportunities", text: "Where practical AI solutions could improve performance, reduce friction or create new capabilities." },
  { title: "A sensible next step", text: "What is worth exploring, what might be involved and whether working together makes sense." },
];

// Why speak with Dori: the angles he brings. Not all are current roles, and
// they were not all held at the same companies; the About page has the detail.
const lenses = [
  { title: "Entrepreneur & operator", text: "Founded and led companies, including The Vets." },
  { title: "Fractional COO", text: "Works directly with businesses on operations and AI implementation." },
  { title: "Finance executive", text: "Fractional CFO experience and fundraising and strategic finance advisory." },
  { title: "AI practitioner", text: "Focuses on integrating AI into practical business workflows, not adopting tools for their own sake." },
];

---

<BaseLayout title={title} description={description} canonicalPath="/book-call/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap grid gap-2xl py-2xl lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-lg lg:gap-y-xl lg:py-3xl">
      <div class="order-1 lg:col-span-6 lg:col-start-1 lg:row-start-1">
        <h1 class="type-h1">Let’s talk about your business.</h1>
        <p class="type-body-lg mt-lg max-w-prose">
          A free 30-minute conversation with
          <a href={sitePath("/about/")}>Dori Fussmann</a>, founder of No Black
          Swan.
        </p>
        <p class="type-body mt-md max-w-prose">
          Tell him how your business operates, what’s slowing it down and what
          you’re trying to improve. Together, we’ll explore where AI could make
          a practical difference — and where it might not.
        </p>
        <p class="mt-md">
          <a href={DORI_LINKEDIN} target="_blank" rel="noopener noreferrer">
            Dori Fussmann on LinkedIn
          </a>
        </p>

        <div class="call-summary mt-xl">
          <h2 class="call-summary__title">You’ll get something useful from the conversation.</h2>
          <p class="type-body mt-sm">
            Within a few hours, we’ll send you a concise, high-level summary of
            the opportunities discussed and a proposed plan for moving forward.
            No charge, no obligation.
          </p>
        </div>

        <h2 class="type-h2 mt-2xl">Who the call is for</h2>
        <p class="type-body mt-md max-w-prose">
          Business owners, founders, CEOs and leadership teams who want to
          understand how AI could improve the way their business operates.
        </p>
        <p class="type-body mt-md max-w-prose">
          You don’t need to know which tools to use or arrive with a technical
          plan. You just need to understand your business and be willing to
          explore how it could work better.
        </p>
      </div>

      <div class="order-3 lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:self-start">
        <h2 class="type-h2">What we'll cover</h2>
        <ol class="call-cover mt-lg">
          {
            cover.map((item, i) => (
              <li class="call-cover__item">
                <span class="call-cover__num">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="call-cover__title">{item.title}</h3>
                <p class="call-cover__text">{item.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="type-body-sm mt-md text-muted">30 minutes · free · no obligation</p>

        <h2 class="type-h2 mt-2xl">Why speak with Dori?</h2>
        <p class="type-body mt-md max-w-prose">
          <a href={sitePath("/about/")}>Dori</a> has built and led businesses,
          worked inside companies as a Fractional COO and AI Operations
          Integrator, served as a Fractional CFO, advised founders on
          fundraising and strategic finance, and worked in investment banking at
          Citi, Morgan Stanley and Ion Pacific.
        </p>
        <p class="type-body mt-md max-w-prose">
          He approaches AI from the perspective of someone who understands what
          it takes to run a business: people, processes, systems, financial
          realities and execution.
        </p>
        <ul class="call-lenses mt-lg">
          {
            lenses.map((l) => (
              <li class="call-lenses__item">
                <span class="call-lenses__title">{l.title}</span>
                <span class="call-lenses__text">{l.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="type-body rule mt-xl max-w-prose pt-lg">
          The objective isn’t to sell you AI. It’s to understand your business,
          identify where there may be a real opportunity and give you a
          practical starting point.
        </p>
        <p class="type-body mt-md max-w-prose">
          If there’s a fit, we’ll explain
          <a href={sitePath("/how-it-works/")}>how we could help</a>. If there
          isn’t, we’ll tell you that too.
        </p>
      </div>

      <div class="order-2 lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1">
        <div class="lead-form" id="booking-scheduler" data-calendar={CAL_COM_URL}>
          <h2 class="type-h2">Pick a day and time</h2>
          <p class="type-body mt-md">
            Choose a convenient 30-minute slot. The consultation is free, and
            you’ll receive a high-level opportunity summary and proposed plan
            within a few hours after the conversation.
          </p>

          <div class="cal-embed" id="cal-embed" aria-label="Booking calendar"></div>
          <p class="form-note">
            Calendar not showing?
            <a href={CAL_COM_URL} target="_blank" rel="noopener noreferrer">Book on Cal.com</a>.
          </p>

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  type CalCommand = ((...args: unknown[]) => void) & {
    loaded?: boolean;
    ns?: Record<string, CalCommand>;
    q?: unknown[];
  };

  declare global {
    interface Window {
      Cal?: CalCommand;
    }
  }

  // Cal.com's embed snippet: queues commands until embed.js loads.
  function ensureCal() {
    if (window.Cal) return;
    const stub = function Cal(...args: unknown[]) {
      const cal = window.Cal as CalCommand;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        document.head.appendChild(document.createElement("script")).src = "https://app.cal.com/embed/embed.js";
        cal.loaded = true;
      }
      (cal.q = cal.q || []).push(args);
    } as CalCommand;
    stub.q = [];
    stub.ns = {};
    window.Cal = stub;
  }

  const scheduler = document.getElementById("booking-scheduler");
  const embed = document.getElementById("cal-embed");
  const calendarUrl = scheduler instanceof HTMLElement ? scheduler.dataset.calendar || "" : "";

  if (embed instanceof HTMLElement && calendarUrl) {
    ensureCal();
    window.Cal?.("init", { origin: "https://cal.com" });
    window.Cal?.("inline", {
      elementOrSelector: embed,
      calLink: new URL(calendarUrl).pathname.replace(/^\/+|\/+$/g, ""),
      config: { layout: "month_view", theme: "light" },
    });

    // Conversion tracking (invisible): record a completed booking in GA4 as
    // `book_call`. Cal.com fires bookingSuccessfulV2 (newer) and/or
    // bookingSuccessful (older); send at most one event per page view.
    let bookingTracked = false;
    const trackBooking = () => {
      if (bookingTracked) return;
      bookingTracked = true;
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      gtag?.("event", "book_call", { method: "cal_com" });
    };
    window.Cal?.("on", { action: "bookingSuccessfulV2", callback: trackBooking });
    window.Cal?.("on", { action: "bookingSuccessful", callback: trackBooking });
  }
</script>

<style>
  /* The free follow-up summary: prominent, but styled as a note, not a paid stage. */
  .call-summary {
    max-width: 42.5rem;
    padding: 20px 24px;
    background: #ffffff;
    border: 1px solid #e4e2de;
    border-left: 3px solid #b5935a;
    border-radius: 8px;
  }
  .call-summary__title {
    font-size: 20px;
    line-height: 1.35;
    font-weight: 500;
    color: #1a1a2e;
  }
  .call-cover {
    display: grid;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin-left: 0;
  }
  @media (min-width: 640px) {
    .call-cover { grid-template-columns: 1fr 1fr; }
  }
  .call-cover__item {
    position: relative;
    background: #ffffff;
    border: 1px solid #e4e2de;
    border-radius: 12px;
    padding: 20px 20px 20px;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .call-cover__item::before {
    content: "";
    position: absolute;
    left: 20px;
    right: 20px;
    top: 0;
    height: 2px;
    background: #b5935a;
    opacity: 0.55;
    border-radius: 0 0 2px 2px;
  }
  .call-cover__item:hover { border-color: #b5935a; transform: translateY(-1px); }
  .call-cover__num {
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: 12px;
    color: #7a5c28;
    letter-spacing: 0.04em;
  }
  .call-cover__title {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 500;
    color: #1a1a2e;
  }
  .call-cover__text {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #2d2d2d;
  }
  .call-lenses {
    list-style: none;
    padding: 0;
    margin-left: 0;
    border-top: 1px solid #e4e2de;
  }
  .call-lenses__item {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid #e4e2de;
  }
  @media (min-width: 640px) {
    .call-lenses__item { grid-template-columns: 160px 1fr; gap: 16px; }
  }
  .call-lenses__title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    color: #7a5c28;
    padding-top: 3px;
  }
  .call-lenses__text {
    font-size: 15px;
    line-height: 1.65;
    color: #2d2d2d;
  }
  @media (prefers-reduced-motion: reduce) {
    .call-cover__item { transition: none; }
    .call-cover__item:hover { transform: none; }
  }
</style>
