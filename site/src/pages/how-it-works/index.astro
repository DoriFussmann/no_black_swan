---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { sitePath } from "../../lib/url";
import howItWorks1 from "../../assets/how-it-works/how-it-works-01.png";
import howItWorks3 from "../../assets/how-it-works/how-it-works-03.png";
import howItWorks5 from "../../assets/how-it-works/how-it-works-05.png";

const title = "How No Black Swan Works | Discovery, Strategy & AI Execution";
const description =
  "See how No Black Swan works: a free consultation, paid fixed-fee discovery, strategy and setup, followed by ongoing AI implementation and operations.";

type Stage = { title: string; body: string };

const pillars: {
  id: string;
  title: string;
  /** Which engagement this stage is, and how it is charged. */
  timing: string;
  summary: string;
  body: string;
  outcome: string;
  src: ImageMetadata;
  alt: string;
  /** A line under the image (optional). */
  caption?: string;
  stages: Stage[];
}[] = [
  {
    id: "understand",
    title: "Understand & Identify",
    timing: "Discovery · Separate fixed fee",
    summary: "Understand the business before deciding what to change.",
    body: "We get inside the business, understand how it operates, map its workflows, systems and constraints, and identify where AI can make a meaningful difference.",
    outcome:
      "A clear understanding of the business and its AI opportunities, providing the foundation for the next stage.",
    src: howItWorks1,
    alt: "Business workflow discussion and assessment",
    caption: "For the record: that\u2019s an AI actor, not me. I\u2019m less photogenic and better with term sheets. - Dori",
    stages: [
      {
        title: "Understand the operation",
        body: "Learn the company’s goals, teams, systems, workflows and constraints.",
      },
      {
        title: "Map the terrain",
        body: "Examine workflows, handoffs, information flows, bottlenecks and decision points.",
      },
      {
        title: "Identify opportunities",
        body: "Find where AI can improve performance, reduce friction or create new capabilities.",
      },
      {
        title: "Prioritize what matters",
        body: "Assess business impact, feasibility, risk and effort to identify the most valuable opportunities.",
      },
    ],
  },
  {
    id: "plan",
    title: "Strategy & Operational Plan",
    timing: "Setup · Agreed scope",
    summary: "Turn the findings into an executable plan.",
    body: "We translate discovery into a practical strategy. We determine what to tackle, in what order, how the solutions should work and what is required to implement them.",
    outcome: "A defined operational plan that establishes what will be implemented and how.",
    src: howItWorks3,
    alt: "Two people mapping an AI-enabled workflow on a laptop and in a notebook",
    caption: "Two dudes, neither of them is me. I\u2019d be the one asking for the spreadsheet. - Dori",
    stages: [
      {
        title: "Set the priorities",
        body: "Rank opportunities by business impact, feasibility, risk and effort.",
      },
      {
        title: "Design the solutions",
        body: "Define workflows, systems, integrations and the human oversight required.",
      },
      {
        title: "Build the execution plan",
        body: "Establish scope, owners, milestones, dependencies and success criteria.",
      },
      {
        title: "Prepare for execution",
        body: "Agree on the tools, resources and implementation requirements.",
      },
    ],
  },
  {
    id: "execute",
    title: "Execute & Operate",
    timing: "Ongoing engagement",
    summary: "Put the plan into action. Make it work in the real world.",
    body: "This is where we get to work. We build, integrate, deploy and operate the solutions alongside your team. Execution doesn’t end at deployment; adoption, feedback and continuous improvement are part of the work.",
    outcome: "Practical AI solutions integrated into the business, with ongoing execution and improvement.",
    src: howItWorks5,
    alt: "Team using an AI-enabled workflow in daily operations",
    caption: "Again, not me. Different AI actor, better hair, thinner. - Dori",
    stages: [
      {
        title: "Build and integrate",
        body: "Develop or configure solutions and connect them to the systems and workflows they need.",
      },
      {
        title: "Deploy and operate",
        body: "Put solutions into daily use, work with teams and address implementation challenges.",
      },
      {
        title: "Measure and improve",
        body: "Monitor performance, gather feedback, identify friction and refine the solutions.",
      },
      {
        title: "Expand",
        body: "Move to the next opportunity as the business and its needs evolve.",
      },
    ],
  },
];

const promises = [
  { value: "Business first", label: "Recommendations start with how your company works and what it needs." },
  { value: "Human judgment", label: "AI supports the work; experience, accountability and decisions remain with people." },
  { value: "Execution matters", label: "The goal is to put useful solutions into operation, not produce a strategy deck and walk away." },
];
---

<BaseLayout title={title} description={description} canonicalPath="/how-it-works/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">The Process</p>
      <h1 class="type-h1 mt-md">From understanding the business to putting AI to work.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        We don’t start by selling you a tool or proposing an off-the-shelf
        solution. We start by understanding how your business operates, identify
        where AI can make a difference, build a practical plan and then execute
        it alongside your team.
      </p>
      <aside class="consult-note mt-xl" aria-labelledby="consult-note-label">
        <p id="consult-note-label" class="consult-note__label">Before the process · Free consultation</p>
        <p class="type-body mt-sm">
          Before the process begins, there’s a free 30-minute consultation with
          Dori. You’ll receive a high-level summary of the opportunities
          discussed and a proposed plan within a few hours, at no charge.
        </p>
      </aside>
      <ol class="step-grid mt-2xl">
        {
          pillars.map((pillar, index) => (
            <li>
              <a class="experience-card experience-card--compact step-card" href={`#${pillar.id}`}>
                <p class="step-card__step">Step {index + 1} · {pillar.timing}</p>
                <p class="experience-card__value">{pillar.title}</p>
                <p class="type-h4">{pillar.summary}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      pillars.map((pillar, index) => (
        <section id={pillar.id} class:list={["site-wrap section-block rule pillar", { "pillar--flip": index % 2 === 1 }]} aria-labelledby={`pillar-${index + 1}`}>
          <div class="pillar__intro">
            <p class="step-script">Step {index + 1}</p>
            <h2 id={`pillar-${index + 1}`} class="type-h2 mt-md">{pillar.title}</h2>
            <p class="type-body-lg mt-md max-w-prose">{pillar.summary}</p>
            <p class="type-body mt-md max-w-prose">{pillar.body}</p>
            <div class="media-frame mt-xl">
              <Image
                class="photo"
                src={pillar.src}
                alt={pillar.alt}
                widths={[640, 960, 1280]}
                sizes="(min-width: 900px) 40vw, 92vw"
              />
            </div>
            {pillar.caption ? <p class="pillar__caption">{pillar.caption}</p> : null}
          </div>
          <div class="plan-card">
            <p class="plan-card__label">{pillar.timing}</p>
            <ol class="plan-steps">
              {pillar.stages.map((stage) => (
                <li>
                  <p class="plan-item__title">{stage.title}</p>
                  <p class="plan-item__body">{stage.body}</p>
                </li>
              ))}
            </ol>
            <div class="plan-outcome">
              <p class="plan-outcome__label">Outcome</p>
              <p class="plan-outcome__body">{pillar.outcome}</p>
            </div>
          </div>
        </section>
      ))
    }

    <section class="site-wrap section-block rule" aria-labelledby="promises-heading">
      <p class="type-label">Throughout</p>
      <h2 id="promises-heading" class="type-h2 mt-md">What guides the work.</h2>
      <ul class="glance-grid glance-grid--3 mt-2xl">
        {
          promises.map((item) => (
            <li class="experience-card experience-card--compact">
              <p class="experience-card__value">{item.value}</p>
              <p class="type-h4">{item.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-2xl flex flex-wrap items-center gap-md">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a Free Consultation</a>
        <a class="btn-quiet" href={sitePath("/pricing/")}>See Pricing</a>
      </p>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<style>
  .pillar__caption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.6;
    font-style: italic;
    color: #5c5c5c;
  }

  /* The free consultation comes before the three stages, so it reads as a
     note rather than as a stage card. */
  .consult-note {
    max-width: 42.5rem;
    padding: 20px 24px;
    border: 1px dashed #c9c5bd;
    border-radius: 8px;
    background: #ffffff;
  }

  .consult-note__label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5c5c5c;
  }

  .plan-outcome {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(18, 128, 106, 0.35);
  }

  .plan-outcome__label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #12806a;
  }

  .plan-outcome__body {
    margin-top: 6px;
    font-size: 17px;
    line-height: 1.5;
    color: #0f172a;
  }
</style>
