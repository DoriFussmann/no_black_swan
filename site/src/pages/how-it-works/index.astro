---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { sitePath } from "../../lib/url";
import howItWorks1 from "../../assets/how-it-works/how-it-works-01.png";
import howItWorks3 from "../../assets/how-it-works/how-it-works-03.png";
import howItWorks5 from "../../assets/how-it-works/how-it-works-05.png";

const title = "How No Black Swan Integrates AI Into Business Operations";
const description =
  "See how No Black Swan works with businesses to identify practical AI opportunities, implement solutions in real workflows and improve them over time.";

type Stage = { title: string; body: string; linkHref?: string; linkLabel?: string };

const pillars: {
  id: string;
  title: string;
  timing: string;
  summary: string;
  src: ImageMetadata;
  alt: string;
  /** A line under the image (optional). */
  caption?: string;
  green: boolean;
  stages: Stage[];
}[] = [
  {
    id: "understand",
    title: "Understand & Identify",
    timing: "Initial engagement",
    summary: "First, understand the business and identify where AI can make a practical difference.",
    src: howItWorks1,
    alt: "Business workflow discussion and assessment",
    caption: "For the record: that\u2019s an AI actor, not me. I\u2019m less photogenic and better with term sheets. - Dori",
    green: true,
    stages: [
      {
        title: "Understand the business",
        body: "A direct working conversation about the company, its goals, teams, systems and how work gets done today.",
      },
      {
        title: "Map the workflows",
        body: "Look at recurring tasks, handoffs, information flows and decisions to understand where time and effort are being lost.",
      },
      {
        title: "Identify AI opportunities",
        body: "Find places where AI can improve or support the work, without forcing AI into processes where it does not belong.",
      },
      {
        title: "Prioritize what matters",
        body: "Assess potential value, feasibility, dependencies and implementation effort to decide what to tackle first.",
      },
    ],
  },
  {
    id: "implement",
    title: "Design & Implement",
    timing: "Agreed project scope",
    summary: "Build and integrate the selected solutions into the company’s actual operations.",
    src: howItWorks3,
    alt: "Two people mapping an AI-enabled workflow on a laptop and in a notebook",
    caption: "Two dudes, neither of them is me. I\u2019d be the one asking for the spreadsheet. - Dori",
    green: true,
    stages: [
      {
        title: "Agree on a practical plan",
        body: "Define the initial scope, priorities and approach before implementation begins.",
      },
      {
        title: "Design the solution",
        body: "Select the appropriate models, tools, integrations and workflow design for the specific business need.",
      },
      {
        title: "Build and connect",
        body: "Configure or develop the solution and connect it with the systems, data and processes it needs to work with.",
      },
      {
        title: "Test and deploy",
        body: "Work with the people who use the process, test it in practice, refine it and put it into operation.",
      },
    ],
  },
  {
    id: "ongoing",
    title: "Measure & Optimize",
    timing: "Monthly engagement",
    summary: "Track what’s working, improve it, then repeat with the next opportunity.",
    src: howItWorks5,
    alt: "Team using an AI-enabled workflow in daily operations",
    caption: "Again, not me. Different AI actor, better hair, thinner. - Dori",
    green: true,
    stages: [
      {
        title: "Measure what’s working",
        body: "Help the team adopt the new workflow, and track how it performs in practice and where it creates friction.",
      },
      {
        title: "Optimize",
        body: "Make sensible refinements based on how the solution is actually used.",
      },
      {
        title: "Repeat",
        body: "Identify and prioritize the next opportunities as the business, its needs and AI capabilities evolve.",
      },
    ],
  },
];

const promises = [
  { value: "Business first", label: "Recommendations start with how your company works and what it needs." },
  { value: "Human judgment", label: "AI supports the work; experience, accountability and decisions remain with people." },
  { value: "Practical implementation", label: "The goal is to put useful solutions into operation, not produce a strategy deck and walk away." },
];
---

<BaseLayout title={title} description={description} canonicalPath="/how-it-works/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">The Process</p>
      <h1 class="type-h1 mt-md">From business understanding to working AI.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        We start by understanding how your company operates, then identify
        where AI can help and implement the opportunities that make sense.
      </p>
      <ol class="step-grid mt-2xl">
        {
          pillars.map((pillar, index) => (
            <li>
              <a class="experience-card experience-card--compact step-card" href={`#${pillar.id}`}>
                <p class="step-card__step">Step {index + 1} · {pillar.timing}</p>
                <p class="experience-card__value">{pillar.title}</p>
                <p class="type-h4">{pillar.summary}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      pillars.map((pillar, index) => (
        <section id={pillar.id} class:list={["site-wrap section-block rule pillar", { "pillar--flip": index % 2 === 1 }]} aria-labelledby={`pillar-${index + 1}`}>
          <div class="pillar__intro">
            <p class="step-script">Step {index + 1}</p>
            <h2 id={`pillar-${index + 1}`} class="type-h2 mt-md">{pillar.title}</h2>
            <p class="type-body-lg mt-md max-w-prose">{pillar.summary}</p>
            <div class="media-frame mt-xl">
              <Image
                class="photo"
                src={pillar.src}
                alt={pillar.alt}
                widths={[640, 960, 1280]}
                sizes="(min-width: 900px) 40vw, 92vw"
              />
            </div>
            {pillar.caption ? <p class="pillar__caption">{pillar.caption}</p> : null}
          </div>
          <div class:list={["plan-card", { "plan-card--plain": !pillar.green }]}>
            <p class="plan-card__label">{pillar.timing}</p>
            <ol class="plan-steps">
              {pillar.stages.map((stage) => {
                const linkAt = stage.linkHref && stage.linkLabel ? stage.body.indexOf(stage.linkLabel) : -1;
                return (
                  <li>
                    <p class="plan-item__title">{stage.title}</p>
                    <p class="plan-item__body">
                      {linkAt >= 0 && stage.linkHref && stage.linkLabel ? (
                        <>{stage.body.slice(0, linkAt)}<a href={sitePath(stage.linkHref)}>{stage.linkLabel}</a>{stage.body.slice(linkAt + stage.linkLabel.length)}</>
                      ) : (
                        stage.body
                      )}
                    </p>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      ))
    }

    <section class="site-wrap section-block rule" aria-labelledby="promises-heading">
      <p class="type-label">Throughout</p>
      <h2 id="promises-heading" class="type-h2 mt-md">What guides the work.</h2>
      <ul class="glance-grid glance-grid--3 mt-2xl">
        {
          promises.map((item) => (
            <li class="experience-card experience-card--compact">
              <p class="experience-card__value">{item.value}</p>
              <p class="type-h4">{item.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-2xl flex flex-wrap items-center gap-md">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a Free Consultation</a>
        <a class="btn-quiet" href={sitePath("/pricing/")}>See Pricing</a>
      </p>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<style>
  .pillar__caption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.6;
    font-style: italic;
    color: #5c5c5c;
  }
</style>
