---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";
import { Content } from "../../legal/terms.md";

const title = `Terms and Conditions | ${SITE_NAME}`;
const description = "The terms for using noblackswan.com and the general framework for No Black Swan’s AI integration services, fees, deliverables and confidentiality.";
---

<BaseLayout title={title} description={description} canonicalPath="/terms/">
  <main id="main-content" class="site-wrap flex-1 py-2xl lg:py-3xl">
    <div>
      <h1 class="type-h1">Terms &amp; Conditions</h1>
      <div class="article-body mt-lg">
        <Content />
      </div>
    </div>
  </main>
</BaseLayout>
