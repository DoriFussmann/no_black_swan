---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_IDENTITY, SITE_NAME } from "../config/site";
import { orgNode, websiteNode } from "seo-core";

const site = SITE_IDENTITY;
const jsonLd = { "@context": "https://schema.org", "@graph": [orgNode(site), websiteNode(site)] };
---

<BaseLayout
  title={`Page not found — ${SITE_NAME}`}
  description="That page is not on the No Black Swan site. Return home, or browse services, articles, and contact to find a page that does exist right now."
  canonicalPath="/404/"
  robots="noindex, follow"
  jsonLd={jsonLd}
>
  <div class="container-page section flex flex-col gap-4">
    <h1 class="h1">Page not found</h1>
    <p>That page is not on this site.</p>
    <p>
      <a href="/">Home</a>
      · <a href="/services/">Services</a>
      · <a href="/articles/">Articles</a>
      · <a href="/contact/">Contact</a>
    </p>
  </div>
</BaseLayout>
