---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { orgId } from "seo-core";
import { SITE_URL } from "../../config/site";
import { absoluteUrl, sitePath } from "../../lib/url";

const title = "AI Integration Pricing & Engagement | No Black Swan";
const description =
  "Understand how No Black Swan engagements are priced: fixed-fee discovery, agreed strategy and setup, and flexible month-to-month AI implementation.";

const glance = [
  { value: "Fixed-fee discovery", label: "A separate, defined first engagement." },
  { value: "Agreed setup scope", label: "Strategy and operational planning." },
  { value: "Flat monthly fee", label: "Ongoing execution, month to month." },
  { value: "Cancel at any time", label: "No long-term commitment." },
];

// The three paid stages. Each is scoped and agreed on its own; no prices are published.
const stages: {
  id: string;
  title: string;
  label: string;
  body: string;
  activities: string[];
  foot?: string;
}[] = [
  {
    id: "discovery",
    title: "Discovery",
    label: "Separate fixed fee",
    body: "Understand the business before deciding what to change. We examine how it operates, map its workflows, systems and constraints, and identify and prioritize meaningful AI opportunities.",
    activities: [
      "Understand the business, its goals, teams, systems and workflows.",
      "Map handoffs, information flows, bottlenecks and decision points.",
      "Identify potential AI opportunities.",
      "Assess business impact, feasibility, risk and effort.",
    ],
  },
  {
    id: "setup",
    title: "Strategy & Setup",
    label: "Agreed scope and fee",
    body: "Turn the findings into an executable operational plan. Define the solutions, workflows, integrations, resources and requirements needed to put them into practice.",
    activities: [
      "Set priorities.",
      "Design the solutions and workflows.",
      "Define systems, integrations and human oversight.",
      "Establish scope, owners, milestones, dependencies and success criteria.",
      "Prepare for execution.",
    ],
  },
  {
    id: "execute",
    title: "Execute & Operate",
    label: "Flat monthly fee · Month to month",
    body: "Build, integrate, deploy and operate the solutions alongside your team. Continue improving them through adoption, feedback and performance monitoring.",
    activities: [
      "Build and integrate solutions into real business workflows.",
      "Deploy and operate them alongside the team.",
      "Monitor performance and address implementation challenges.",
      "Gather feedback and refine solutions.",
      "Identify and pursue further opportunities as the business evolves.",
    ],
    foot: "The ongoing engagement runs month to month on a flat monthly fee. You can cancel at any time.",
  },
];

const fitYes = [
  "Want to integrate AI into real business operations, not just experiment with tools",
  "Are open to examining existing workflows and changing how work gets done",
  "Want experienced business guidance alongside hands-on implementation",
  "Are willing to work collaboratively with us to test, adopt and improve solutions",
];

const fitNo = [
  "Expect guaranteed revenue, savings or other outcomes",
  "Want AI added everywhere regardless of whether it makes sense",
  "Expect a completely hands-off transformation without involvement from the business",
];

const faqs = [
  {
    question: "How much does it cost?",
    answer:
      "Each stage is scoped and priced separately. Discovery is a fixed-fee engagement. Strategy and setup are agreed based on the work required. Ongoing execution and operation are charged at a flat monthly fee. We explain the scope and fees before you commit to each stage.",
  },
  {
    question: "Why don’t you publish fixed prices?",
    answer:
      "Because businesses, systems, workflows and implementation requirements vary. We don’t sell generic packages. We first understand the business and the opportunities, then define the scope and fee for the work involved.",
  },
  {
    question: "What happens during discovery?",
    answer:
      "We get to know the business, examine its operations, workflows and systems, identify potential AI opportunities, and assess their business impact, feasibility, risk and effort. Discovery is a separate, fixed-fee engagement. It does not commit you to proceeding with strategy, setup or implementation.",
  },
  {
    question: "Is there a minimum commitment?",
    answer:
      "No. The ongoing engagement runs month to month on a flat monthly fee. You can cancel at any time.",
  },
  {
    question: "Do you guarantee specific results?",
    answer:
      "No. We do not promise a particular level of savings, revenue growth or productivity improvement. We bring experienced business judgment and work to implement useful AI solutions, but outcomes depend on the business, the opportunities and how solutions are adopted.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Integration Services",
    provider: { "@id": orgId(SITE_URL) },
    serviceType: "Business consulting and AI integration",
    url: absoluteUrl("/pricing/"),
    description:
      "A separate fixed-fee discovery to understand the business and identify AI opportunities, then strategy and setup with an agreed scope and fee, followed by ongoing execution and operation on a flat monthly fee, month to month.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/pricing/" jsonLd={jsonLd}>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">Pricing</p>
      <h1 class="type-h1 mt-md">A practical engagement, scoped to your business.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        Every business is different. We start by understanding how yours
        operates, identify where AI can make a meaningful difference, and define
        a practical plan for putting it to work.
      </p>
      <p class="type-body-lg mt-md max-w-prose">
        The engagement begins with a separate, fixed-fee discovery phase,
        followed by strategy and setup, then an ongoing monthly engagement for
        execution and operation. You’ll know the scope and fees before
        committing to each stage.
      </p>
      <ul class="glance-grid mt-2xl" aria-label="At a glance">
        {
          glance.map((item) => (
            <li class="experience-card experience-card--compact">
              <p class="experience-card__value">{item.value}</p>
              <p class="type-h4">{item.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-2xl">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a Free Consultation</a>
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="plan-heading">
      <p class="type-label">What you pay for</p>
      <h2 id="plan-heading" class="type-h2 mt-md">Three stages, each scoped and agreed separately.</h2>
      <aside class="consult-note mt-xl" aria-labelledby="consult-note-label">
        <p id="consult-note-label" class="consult-note__label">Before the stages · Free consultation</p>
        <p class="type-body mt-sm">
          It starts with a free 30-minute consultation with Dori. The
          consultation is not paid discovery, and it doesn’t commit you to
          anything.
        </p>
      </aside>
      <ol class="stage-grid mt-2xl">
        {
          stages.map((stage, index) => (
            <li>
              <article class="plan-card" aria-labelledby={`${stage.id}-title`}>
                <p class="step-script">Stage {index + 1}</p>
                <h3 id={`${stage.id}-title`} class="plan-card__title">{stage.title}</h3>
                <p class="plan-card__label mt-sm">{stage.label}</p>
                <p class="plan-card__lead type-body">{stage.body}</p>
                <ul class="fit-list">
                  {stage.activities.map((line) => <li>{line}</li>)}
                </ul>
                {stage.foot ? <p class="plan-card__foot">{stage.foot}</p> : null}
              </article>
            </li>
          ))
        }
      </ol>
      <p class="type-body mt-xl max-w-prose">
        Each stage is agreed on its own. Completing one doesn’t commit you to
        the next. See <a href={sitePath("/how-it-works/")}>the process</a> in
        full.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="why-heading">
      <p class="type-label">Why this model</p>
      <h2 id="why-heading" class="type-h2 mt-md">The work should fit the business, not a prebuilt package.</h2>
      <p class="type-body mt-md max-w-prose">
        Every business has different workflows, systems, people and priorities.
        We don’t sell generic AI packages or prescribe technology before
        understanding the problem.
      </p>
      <p class="type-body mt-md max-w-prose">
        We first understand the business, then define the scope and requirements
        for each stage. This gives us a practical way to prioritize the right
        opportunities, implement solutions properly and adapt as the business
        evolves.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="fit-heading">
      <p class="type-label">Who it's for</p>
      <h2 id="fit-heading" class="type-h2 mt-md">Businesses ready to put AI to work.</h2>
      <div class="fit-grid mt-2xl">
        <div class="plan-card">
          <p class="plan-card__label">A good fit if you</p>
          <ul class="fit-list">
            {fitYes.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="plan-card plan-card--plain">
          <p class="plan-card__label" style="color: #5C5C5C">Not the right fit if you</p>
          <ul class="fit-list fit-list--no">
            {fitNo.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<style>
  /* Three sequential stages: one column on small screens, three across on wide ones. */
  .stage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    list-style: none;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    align-items: stretch;
  }

  .stage-grid > li {
    display: flex;
  }

  .stage-grid .plan-card {
    width: 100%;
    padding: 32px 28px;
  }

  @media (min-width: 1024px) {
    .stage-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The free consultation comes before the paid stages, so it reads as a note. */
  .consult-note {
    max-width: 42.5rem;
    padding: 20px 24px;
    border: 1px dashed #c9c5bd;
    border-radius: 8px;
    background: #ffffff;
  }

  .consult-note__label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5c5c5c;
  }
</style>
