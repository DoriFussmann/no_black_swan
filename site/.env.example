# Public build-time settings. Copy to site/.env for local overrides; set the same
# names in Vercel → Settings → Environment Variables for production.
# Leave a value empty to keep that feature off. Do not invent IDs.
# The site renders without these values. Analytics is not active until a real
# GA4 measurement ID is set and the production build is checked.

# Google Analytics 4 measurement ID from the GA4 property, e.g. G-XXXXXXXXXX
PUBLIC_ANALYTICS_ID=

# Google Search Console HTML-tag verification token from Search Console
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
